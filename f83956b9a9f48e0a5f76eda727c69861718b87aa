      "writtenOn": "2022-01-13T01:23:05Z",
      "side": 1,
      "message": "The preference is not a SwitchPreference, how do users know if MTE is enable or not from the UI?",
      "range": {
        "startLine": 47,
        "startChar": 9,
        "endLine": 47,
        "endChar": 19
      },
      "revId": "f83956b9a9f48e0a5f76eda727c69861718b87aa",
